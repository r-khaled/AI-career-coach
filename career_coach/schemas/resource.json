{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource_id",
    "kind",
    "course_id",
    "title",
    "url",
    "duration_hours",
    "prerequisite_status",
    "reason",
    "evidence_ids"
  ],
  "properties": {
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "internal",
        "external"
      ]
    },
    "course_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "duration_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "prerequisite_status": {
      "enum": [
        "none",
        "included",
        "user_confirmed_equivalence",
        "unresolved"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicc:resource:1"
}
