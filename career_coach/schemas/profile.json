{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "facts",
    "assumptions",
    "confirmed_assumption_ids",
    "approved_profile_version",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value",
          "source_question_id",
          "basis"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "source_question_id": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "user_reported",
              "inferred"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumption_id",
          "description",
          "course_ids"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "course_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "confirmed_assumption_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_profile_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicc:profile:1"
}
