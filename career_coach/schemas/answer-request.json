{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicc:answer-request:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "answer",
    "state_version",
    "request_id"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
