{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "status",
    "stage",
    "plan_id",
    "revision",
    "profile_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed"
      ]
    },
    "stage": {
      "enum": [
        "queued",
        "retrieval",
        "external_search",
        "outline",
        "generation",
        "validation",
        "complete",
        "failed"
      ]
    },
    "stale_profile": {
      "type": "boolean"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aicc:job:1"
}
